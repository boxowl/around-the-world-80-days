<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only world demo (P07). No LAUNCHER category: start explicitly with
             adb shell am start -n com.boxowl.aroundtheworld/.debug.JourneyDemoActivity -->
        <activity
            android:name=".debug.JourneyDemoActivity"
            android:exported="true"
            android:label="Journey demo"
            android:theme="@style/Theme.Expedition" />
        <!-- Debug-only V21 globe prototype. Start explicitly with
             adb shell am start -n com.boxowl.aroundtheworld/.debug.globe.GlobeProtoActivity -->
        <activity
            android:name=".debug.globe.GlobeProtoActivity"
            android:exported="true"
            android:label="Globe proto"
            android:theme="@style/Theme.Expedition" />
        <!-- Debug-only V2.0d slice: synthetic meters -> CreditLedger -> RouteDatasetV1
             position on the globe. Start explicitly with
             adb shell am start -n com.boxowl.aroundtheworld/.debug.globe.GlobeSliceActivity
             (extras: scenario, meters_prev, meters_today — see GlobeSliceActivity kdoc) -->
        <activity
            android:name=".debug.globe.GlobeSliceActivity"
            android:exported="true"
            android:label="Globe slice V2.0d"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Expedition" />
    </application>
</manifest>
